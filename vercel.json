{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/tools/:slug", "destination": "/tools/:slug.html" },
    { "source": "/guides/:slug", "destination": "/guides/:slug.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/guides/index.html", "destination": "/guides", "permanent": true },
    { "source": "/tools/:slug.html", "destination": "/tools/:slug", "permanent": true },
    { "source": "/guides/:slug.html", "destination": "/guides/:slug", "permanent": true }
  ]
}
