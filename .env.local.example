# Copy this file to .env.local and fill in real values. .env.local is
# gitignored -- it never gets committed. These are the same variable names
# configured in the Vercel dashboard (Project Settings -> Environment
# Variables) for the deployed site; keeping the names identical means code
# behaves the same locally and in production.

# Used by api/contact.mjs to send the contact form via Resend.
RESEND_TOKEN=

# Used by api/share.mjs and api/contact.mjs for share-pad storage and
# contact-form rate limiting (Upstash Redis REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
