# Local environment variables (keeps your Upstash/database secrets safe locally)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment cache and config
.vercel

# Node dependencies (if you run builds locally)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (Vercel builds this fresh from source on every deploy)
dist/

# System Files
.DS_Store
Thumbs.db

# Internal notes not meant for the repo (competitive analysis, monetization
# targets, launch drafts) -- keep local regardless of repo visibility.
TRAFFIC-STRATEGY.md
PLAN.md
